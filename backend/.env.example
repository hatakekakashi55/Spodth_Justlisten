# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://spodth_user:your_password@localhost:5432/spodth_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spodth_db
DB_USER=spodth_user
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Spotify OAuth Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 (Optional for large deployments)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET_NAME=spodth-music

# Session Secret
SESSION_SECRET=your_session_secret_key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Render Uptime Ping (for keeping server awake)
RENDER_EXTERNAL_URL=https://spodth-api.onrender.com
